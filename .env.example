# Copy this file to .env (git-ignored) and fill in the EMPTY values. Never commit .env.
# docker compose refuses to start while POSTGRES_PASSWORD or JWT_SECRET are empty.

# --- Database ---
POSTGRES_DB=clickandtap
POSTGRES_USER=clickandtap
POSTGRES_PASSWORD=

# --- Security ---
# At least 32 random characters. Generate one in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=

# Browser origins allowed to call the API, comma separated (Flutter web needs its exact origin and port).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- First administrator (created on startup only if the e-mail does not exist yet) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional ---
# Publish Swagger UI at /swagger-ui.html. Keep false anywhere the API is public.
SWAGGER_ENABLED=false
# Host port for the API.
API_PORT=8088
