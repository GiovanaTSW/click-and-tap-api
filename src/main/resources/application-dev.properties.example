# Copy this file to application-dev.properties (git-ignored) and fill in your own values.
server.port=8088

spring.datasource.url=jdbc:postgresql://localhost:5432/clickandtap
spring.datasource.username=postgres
spring.datasource.password=change-me

spring.jpa.show-sql=true

# At least 32 characters. Generate one with: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
jwt.secret=change-me-to-a-random-string-of-at-least-32-chars
jwt.expiration-ms=86400000

# Flutter web needs a fixed port, e.g. flutter run -d chrome --web-port 3000
cors.allowed-origins=http://localhost:3000,http://localhost:4200,http://localhost:5173

# Initial admin (created on startup if the email does not exist) and sample products.
app.admin.name=Admin
app.admin.email=admin@example.com
app.admin.password=change-me-min-8-chars
app.seed-sample-data=true
